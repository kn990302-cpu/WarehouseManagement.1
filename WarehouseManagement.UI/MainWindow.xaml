<Window x:Class="WarehouseManagement.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Quản lý kho hàng"
        Width="1280" Height="760"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <DockPanel>

        <!-- ===== Thanh tiêu đề ===== -->
        <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryMid" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Warehouse" Width="28" Height="28" VerticalAlignment="Center" />
                    <TextBlock Text="QUẢN LÝ KHO HÀNG"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="18" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountCircle" Width="24" Height="24" VerticalAlignment="Center" />
                    <StackPanel Margin="8,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText" FontWeight="SemiBold" />
                        <TextBlock x:Name="UserRoleText" FontSize="11" Opacity="0.8" />
                    </StackPanel>
                    <Button x:Name="ChangePasswordButton"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=materialDesign:ColorZone}, Path=Foreground}"
                            ToolTip="Đổi mật khẩu"
                            Click="ChangePasswordButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockReset" VerticalAlignment="Center" />
                            <TextBlock Text="Đổi mật khẩu" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LogoutButton"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=materialDesign:ColorZone}, Path=Foreground}"
                            ToolTip="Đăng xuất"
                            Click="LogoutButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" VerticalAlignment="Center" />
                            <TextBlock Text="Đăng xuất" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- ===== Menu bên trái ===== -->
        <Border DockPanel.Dock="Left"
                Width="230"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource MaterialDesignDivider}">
            <ListBox x:Name="NavList"
                     Margin="0,8,0,0"
                     SelectionChanged="NavList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8,6">
                            <materialDesign:PackIcon Kind="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ===== Vùng nội dung: màn hình của từng module hiện ở đây ===== -->
        <ContentControl x:Name="ContentArea" Margin="0" />
    </DockPanel>
</Window>
