<UserControl x:Class="WarehouseManagement.UI.Views.Admin.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="UserControl_Loaded">
    <!-- Người phụ trách: Nguyễn Bình Khang -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                   Text="Quản lý người dùng"
                   Margin="0,0,0,16"
                   FontSize="24" FontWeight="SemiBold" />

        <!-- ===== Danh sách tài khoản ===== -->
        <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,16,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right"
                            Content="TÌM"
                            Margin="8,0,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="SearchButton_Click" />
                    <TextBox x:Name="SearchBox"
                             materialDesign:HintAssist.Hint="Tìm theo tên đăng nhập hoặc họ tên"
                             KeyDown="SearchBox_KeyDown" />
                </DockPanel>

                <DataGrid x:Name="UserGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionChanged="UserGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" />
                        <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleName}" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" />
                        <DataGridTextColumn Header="Đăng nhập gần nhất"
                                            Binding="{Binding LastLoginAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </materialDesign:Card>

        <!-- ===== Form thêm / sửa ===== -->
        <materialDesign:Card Grid.Row="1" Grid.Column="1" Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="FormTitle"
                           Text="Thêm tài khoản mới"
                           Margin="0,0,0,16"
                           FontSize="16" FontWeight="SemiBold" />

                <TextBox x:Name="UsernameBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Tên đăng nhập"
                         Margin="0,0,0,12" />

                <TextBox x:Name="FullNameBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Họ tên"
                         Margin="0,0,0,12" />

                <ComboBox x:Name="RoleBox"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Vai trò"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Margin="0,0,0,12" />

                <PasswordBox x:Name="PasswordInput"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             materialDesign:HintAssist.Hint="Mật khẩu (tối thiểu 6 ký tự)"
                             Margin="0,0,0,4" />
                <TextBlock Text="Bắt buộc khi tạo mới. Khi đang sửa, chỉ dùng cho nút Đặt lại mật khẩu."
                           Margin="0,0,0,12"
                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" />

                <TextBlock x:Name="MessageText" Margin="0,0,0,12" TextWrapping="Wrap" />

                <UniformGrid Columns="2">
                    <Button x:Name="SaveButton"
                            Content="LƯU"
                            Margin="0,0,4,8"
                            Click="SaveButton_Click" />
                    <Button Content="LÀM MỚI"
                            Margin="4,0,0,8"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="NewButton_Click" />
                    <Button x:Name="ToggleActiveButton"
                            Content="KHÓA"
                            Margin="0,0,4,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="ToggleActiveButton_Click" />
                    <Button x:Name="ResetPasswordButton"
                            Content="ĐẶT LẠI MK"
                            Margin="4,0,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="ResetPasswordButton_Click" />
                </UniformGrid>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
