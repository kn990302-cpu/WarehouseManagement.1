<Window x:Class="WarehouseManagement.UI.Views.Auth.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Đổi mật khẩu"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        FocusManager.FocusedElement="{Binding ElementName=CurrentPasswordBox}">
    <!-- Người phụ trách: Nguyễn Bình Khang -->
    <StackPanel Margin="24">
        <TextBlock Text="Đổi mật khẩu"
                   Margin="0,0,0,4"
                   FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="AccountText"
                   Margin="0,0,0,20"
                   Opacity="0.65" />

        <PasswordBox x:Name="CurrentPasswordBox"
                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                     materialDesign:HintAssist.Hint="Mật khẩu hiện tại"
                     Margin="0,0,0,12" />

        <PasswordBox x:Name="NewPasswordBox"
                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                     materialDesign:HintAssist.Hint="Mật khẩu mới (tối thiểu 6 ký tự)"
                     Margin="0,0,0,12" />

        <PasswordBox x:Name="ConfirmPasswordBox"
                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                     materialDesign:HintAssist.Hint="Nhập lại mật khẩu mới"
                     Margin="0,0,0,8" />

        <TextBlock x:Name="ErrorText"
                   MinHeight="20"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Foreground="#D32F2F" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- IsCancel: bấm HỦY hoặc phím Esc sẽ tự đóng cửa sổ -->
            <Button Content="HỦY"
                    IsCancel="True"
                    Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
            <Button x:Name="SaveButton"
                    Content="ĐỔI MẬT KHẨU"
                    IsDefault="True"
                    Click="SaveButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
