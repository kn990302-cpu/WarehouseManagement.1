<Window x:Class="WarehouseManagement.UI.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Đăng nhập - Quản lý kho"
        Width="420" Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        FocusManager.FocusedElement="{Binding ElementName=UsernameBox}">

    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">

            <materialDesign:PackIcon Kind="Warehouse"
                                     Width="64" Height="64"
                                     HorizontalAlignment="Center"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />

            <TextBlock Text="QUẢN LÝ KHO HÀNG"
                       Margin="0,12,0,4"
                       HorizontalAlignment="Center"
                       FontSize="22" FontWeight="SemiBold" />

            <TextBlock Text="Đăng nhập để tiếp tục"
                       Margin="0,0,0,28"
                       HorizontalAlignment="Center"
                       Opacity="0.65" />

            <TextBox x:Name="UsernameBox"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Tên đăng nhập"
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.LeadingIcon="Account"
                     Margin="0,0,0,16" />

            <PasswordBox x:Name="PasswordBox"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         materialDesign:HintAssist.Hint="Mật khẩu"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Lock"
                         Margin="0,0,0,8" />

            <TextBlock x:Name="ErrorText"
                       MinHeight="20"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Foreground="#D32F2F" />

            <Button x:Name="LoginButton"
                    Content="ĐĂNG NHẬP"
                    Height="44"
                    IsDefault="True"
                    Click="LoginButton_Click" />

            <ProgressBar x:Name="LoadingBar"
                         Margin="0,12,0,0"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
