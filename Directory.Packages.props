<Project>
  <!--
    QUẢN LÝ PHIÊN BẢN NUGET TẬP TRUNG
    - Mọi phiên bản package của cả solution nằm ở đây, nên 5 người luôn dùng cùng một bản.
    - Trong file .csproj chỉ ghi <PackageReference Include="TênPackage" />, KHÔNG ghi Version.
    - Muốn thêm/nâng cấp package: báo Khang để sửa file này (tránh conflict).
    - Nếu nhóm chuyển sang .NET 8: đổi các package Microsoft.* về bản 8.0.x.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Cho phép ép phiên bản cả những package đi kèm gián tiếp (xem mục "Vá bảo mật" bên dưới) -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Entity Framework Core (DAL + công cụ migration) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0" />

    <!-- Đọc appsettings.json -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />

    <!-- Bảo mật mật khẩu (Khang) -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- Xuất Excel (Thái Anh) -->
    <PackageVersion Include="ClosedXML" Version="0.104.2" />

    <!-- Giao diện -->
    <PackageVersion Include="MaterialDesignThemes" Version="5.2.1" />

    <!--
      Vá bảo mật: EF Core SqlServer kéo theo System.Security.Cryptography.Pkcs 9.0.4,
      bản này dính lỗ hổng GHSA-846f-f764-76mx và GHSA-2fmv-rv2c-59x7 (cảnh báo NU1902/NU1903).
      Cảnh báo đó còn làm lệnh Add-Migration bị dừng. Ép lên bản đã vá 10.0.13.
      Khi nâng EF Core lên bản mới, có thể xóa dòng này nếu không còn cảnh báo.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
